#!/usr/bin/expect -f
#
# run_soc_inference.expect
#
# 1. Connects to the FPGA over UART (picocom)
# 2. Triggers a reset (FPGA reprogram via Vivado) so the boot is visible
# 3. Retries up to 5 times if Linux does not boot / SD card errors
# 4. Runs /Test/run_inference_benchmarks.sh <bitstream_name> on the SoC
#    (runs ImageNet CNN + Transformer suites, saves to /Test/results/)
# 5. Results are already organised by the script — no extra copy needed
#
# Usage (called by batch_inference.sh):
#   expect run_soc_inference.expect <bitstream_name> <bitfile_path>

set bitstream_name [lindex $argv 0]
set bitfile        [lindex $argv 1]

if {$bitstream_name eq "" || $bitfile eq ""} {
    puts "ERROR: Two arguments required."
    puts "Usage: expect run_soc_inference.expect <bitstream_name> <bitfile_path>"
    exit 1
}
if {![file exists $bitfile]} {
    puts "ERROR: Bitstream file not found: $bitfile"
    exit 1
}

set timestamp  [exec date +%Y%m%d_%H%M%S]
set script_dir [file dirname [file normalize [info script]]]
set reset_tcl  "$script_dir/reset_fpga.tcl"

# ── Serial device — mirrors connect_serial.sh preference ──────────────────
if {[file exists "/dev/ttyUSB1"]} {
    set device "/dev/ttyUSB1"
} else {
    set device "/dev/ttyUSB0"
}
set baudrate 115200

puts "INFO: Device      : $device @ $baudrate baud"
puts "INFO: Bitstream   : $bitstream_name"
puts "INFO: Results dir : /Test/results/<timestamp>_${bitstream_name}  (created on SoC)"

# ── Kill stale serial processes — mirrors connect_serial.sh ───────────────
catch {exec sudo fuser -k $device}
catch {exec sudo pkill -f "picocom.*ttyUSB"}
catch {exec sudo pkill -f "screen.*ttyUSB"}
after 1000

catch {exec sudo stty -F $device $baudrate raw -echo -crtscts -hupcl}

# ── Launch picocom FIRST — so the boot output is captured from the start ──
spawn picocom -b $baudrate --flow n --noinit --noreset $device

set timeout 15
expect {
    "Terminal ready" { puts "INFO: Serial port open." }
    timeout          { puts "ERROR: picocom did not start."; exit 1 }
}

# ── Reset loop — same two-stage detection as run_soc_benchmark.expect ─────
set booted 0
for {set attempt 1} {$attempt <= 5} {incr attempt} {
    puts "INFO: Reset attempt $attempt/5 — reprogramming FPGA..."

    catch {exec vivado -mode batch -nolog -nojournal \
               -source $reset_tcl -tclargs $bitfile} vivado_out

    puts "INFO: FPGA reset done. Waiting for boot activity (stage 1, 60 s)..."

    set boot_started 0
    set timeout 60
    expect {
        -re {OpenSBI|U-Boot|SD Boot|Booting Linux|Starting kernel} {
            set boot_started 1
            puts "INFO: Boot in progress — waiting for shell prompt (stage 2, 6 min)..."
        }
        -re {[#$] } { set booted 1 }
        timeout     { puts "INFO: No boot activity on attempt $attempt — will retry reset." }
    }

    if {$booted} { puts "INFO: Linux booted on attempt $attempt."; break }

    if {$boot_started} {
        set timeout 360
        expect {
            -re {[#$] }          { set booted 1 }
            -re {CMD[0-9]+ERROR} {
                puts "INFO: SD card error — retrying reset immediately."
            }
            timeout { puts "WARNING: Boot started but shell prompt not seen in 6 min." }
        }
    }

    if {$booted} { puts "INFO: Linux booted on attempt $attempt."; break }
}

if {!$booted} {
    puts "ERROR: Linux did not boot after 5 reset attempts."
    send "\x01\x78"
    exit 1
}

# Confirm prompt is live
send "\r"
set timeout 15
expect -re {[#$] }

# ── Run inference benchmarks ──────────────────────────────────────────────
# The script takes the bitstream name as config label, and writes results to
# /Test/results/<timestamp>_<bitstream_name>/ — no manual copy needed.
puts "INFO: Running inference benchmarks (ImageNet + Transformer)..."
send "cd /Test && sh run_inference_benchmarks.sh $bitstream_name\r"

# ImageNet CNNs + Transformers on a 35 MHz FPGA can take a long time.
# Allow up to 3 hours before giving up.
set timeout 10800
expect {
    "Run Complete" { puts "INFO: Inference benchmarks complete." }
    timeout        { puts "WARNING: Timed out waiting for inference benchmarks." }
}

set timeout 30
expect -re {[#$] }

puts "INFO: Done — $bitstream_name"
puts "INFO: Results at /Test/results/ on the SoC SD card."

send "\x01\x78"
exit 0
