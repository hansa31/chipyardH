#!/usr/bin/expect -f
#
# run_soc_inference_v2.expect
#
# Fixes applied (from BATCH_INFERENCE_NOTES.md):
#   Fix 1: No global 3-hour timeout. Each test is watched for its own pattern.
#   Fix 2: SoC wall clock set via 'date -s <host_ts>' before benchmarks run.
#   Fix 4: Redundant Step 1 Vivado call removed from the batch script. This
#          script handles all FPGA programming + reset through the boot loop.
#
# Test sequence (CIFAR-10 models are deliberately skipped — already collected):
#   [1/3] resnet50_v1-linux          -> stop after [Images 1-100] window line (after batch 25)
#   [2/3] mobilenet_v1-linux         -> stop after [Images 1-100] window line (after batch 25)
#   [3/3] bert-tiny-sst2-stream-linux -> all 100 examples; stop when done or at 15 min
#                                        (hard ceiling: 15 minutes / 900 s)
#
# Usage (called by batch_inference_v2.sh):
#   expect run_soc_inference_v2.expect <bitstream_name> <bitfile_path> <host_timestamp>

set bitstream_name [lindex $argv 0]
set bitfile        [lindex $argv 1]
set host_ts        [lindex $argv 2]

if {$bitstream_name eq "" || $bitfile eq "" || $host_ts eq ""} {
    puts "ERROR: Three arguments required."
    puts "Usage: expect run_soc_inference_v2.expect <bitstream_name> <bitfile_path> <host_ts>"
    exit 1
}
if {![file exists $bitfile]} {
    puts "ERROR: Bitstream file not found: $bitfile"
    exit 1
}

set script_dir [file dirname [file normalize [info script]]]
set reset_tcl  "$script_dir/reset_fpga.tcl"

# ── Serial device — mirrors connect_serial.sh preference ──────────────────
if {[file exists "/dev/ttyUSB1"]} {
    set device "/dev/ttyUSB1"
} else {
    set device "/dev/ttyUSB0"
}
set baudrate 115200

puts "INFO: Device      : $device @ $baudrate baud"
puts "INFO: Bitstream   : $bitstream_name"
puts "INFO: Host TS     : $host_ts"

# ── Boot loop ─────────────────────────────────────────────────────────────
# Picocom is spawned AFTER each Vivado call, not before.
# Reason: Vivado grabs the FT2232H USB chip for JTAG, which momentarily
# makes the UART side (/dev/ttyUSBx) unavailable and kills any picocom
# session that was already open.
set booted 0
for {set attempt 1} {$attempt <= 5} {incr attempt} {
    puts "INFO: Reset attempt $attempt/5 — reprogramming FPGA..."

    catch {exec vivado -mode batch -nolog -nojournal \
               -source $reset_tcl -tclargs $bitfile} vivado_out

    puts "INFO: FPGA programmed. Waiting 2 s for FT2232H USB to settle..."
    after 2000

    # Kill any stale picocom from a previous iteration, then re-spawn fresh.
    catch {exec sudo -n fuser -k $device}
    catch {exec sudo -n pkill -f "picocom.*ttyUSB"}
    catch {exec sudo -n pkill -f "screen.*ttyUSB"}
    after 500
    catch {exec sudo -n stty -F $device $baudrate raw -echo -crtscts -hupcl}

    # Open device permissions using cached sudo so picocom runs without sudo.
    catch {exec sudo -n chmod 666 $device}

    spawn picocom -b $baudrate --flow n --noinit --noreset $device

    set timeout 15
    set picocom_ok 0
    expect {
        "Terminal ready" { puts "INFO: Serial port open."; set picocom_ok 1 }
        timeout          { puts "WARNING: picocom did not start on attempt $attempt." }
    }
    if {!$picocom_ok} { catch {close}; catch {wait}; continue }

    # Two-stage boot detection
    set boot_started 0
    set timeout 60
    expect {
        -re {OpenSBI|U-Boot|SD Boot|Booting Linux|Starting kernel} {
            set boot_started 1
            puts "INFO: Boot in progress — waiting for shell prompt (stage 2, 6 min)..."
        }
        -re {[#$] } { set booted 1 }
        timeout     { puts "INFO: No boot activity on attempt $attempt — will retry." }
    }

    if {$booted} { puts "INFO: Linux booted on attempt $attempt."; break }

    if {$boot_started} {
        set timeout 360
        expect {
            -re {[#$] }          { set booted 1 }
            -re {CMD[0-9]+ERROR} { puts "INFO: SD card error — retrying reset." }
            timeout { puts "WARNING: Boot started but shell prompt not seen in 6 min." }
        }
    }

    if {$booted} { puts "INFO: Linux booted on attempt $attempt."; break }

    # Picocom still open but boot failed — close it before next Vivado call
    catch {close}
    catch {wait}
}

if {!$booted} {
    puts "ERROR: Linux did not boot after 5 reset attempts."
    exit 1
}

# Confirm prompt is live
send "\r"
set timeout 15
expect -re {[#$] }

# ── Fix 2: Set SoC wall clock from host timestamp ─────────────────────────
# host_ts format: YYYYMMDD_HHMMSS  ->  "YYYY-MM-DD HH:MM:SS"
set yr  [string range $host_ts  0  3]
set mo  [string range $host_ts  4  5]
set dy  [string range $host_ts  6  7]
set hh  [string range $host_ts  9 10]
set mm  [string range $host_ts 11 12]
set ss  [string range $host_ts 13 14]
set soc_date "${yr}-${mo}-${dy} ${hh}:${mm}:${ss}"

puts "INFO: Setting SoC clock to: $soc_date"
send "date -s \"$soc_date\"\r"
set timeout 10
expect -re {[#$] }

# ══════════════════════════════════════════════════════════════════════════
# Test 1 of 3 — resnet50_v1
# After batch 25/125 the binary prints two lines:
#   [Images 1-100] Window Top-1: XX/100 (XX.0%), Top-5: XX/100 (XX.0%)
#   [Cumulative 100/500] Top-1: XX.XX%, Top-5: XX.XX%
# We wait for the first, let the cumulative line flush, then Ctrl+C.
# No meaningful timeout — 3 hours is just a hang-guard.
# ══════════════════════════════════════════════════════════════════════════
puts "INFO: \[1/3\] resnet50_v1 — waiting for \[Images 1-100\] window line..."
send "cd /Test/imagenet && ./resnet50_v1-linux\r"

set timeout 10800
expect {
    -re {\[Images 1-100\][^\r\n]*} {
        set line $expect_out(0,string)
        puts "\nINFO: resnet50_v1  RESULT: $line"
        # Wait briefly so the [Cumulative 100/500] line also prints to the log
        set timeout 3
        expect {
            -re {\[Cumulative[^\r\n]*} {
                set cline $expect_out(0,string)
                puts "INFO: resnet50_v1  CUMULATIVE: $cline"
            }
            timeout {}
        }
        send "\003"
        set timeout 15
        expect {
            -re {[#$] } {}
            timeout {
                send "\r"
                set timeout 10
                expect -re {[#$] }
            }
        }
    }
    timeout {
        puts "WARNING: resnet50_v1 — hang-guard fired before \[Images 1-100\] appeared."
        send "\003"
        set timeout 15
        expect {
            -re {[#$] } {}
            timeout {
                send "\r"
                set timeout 10
                expect -re {[#$] }
            }
        }
    }
}

# ══════════════════════════════════════════════════════════════════════════
# Test 2 of 3 — mobilenet_v1
# Same pattern as resnet50_v1 above.
# ══════════════════════════════════════════════════════════════════════════
puts "INFO: \[2/3\] mobilenet_v1 — waiting for \[Images 1-100\] window line..."
send "cd /Test/imagenet && ./mobilenet_v1-linux\r"

set timeout 10800
expect {
    -re {\[Images 1-100\][^\r\n]*} {
        set line $expect_out(0,string)
        puts "\nINFO: mobilenet_v1  RESULT: $line"
        # Wait briefly so the [Cumulative 100/500] line also prints to the log
        set timeout 3
        expect {
            -re {\[Cumulative[^\r\n]*} {
                set cline $expect_out(0,string)
                puts "INFO: mobilenet_v1  CUMULATIVE: $cline"
            }
            timeout {}
        }
        send "\003"
        set timeout 15
        expect {
            -re {[#$] } {}
            timeout {
                send "\r"
                set timeout 10
                expect -re {[#$] }
            }
        }
    }
    timeout {
        puts "WARNING: mobilenet_v1 — hang-guard fired before \[Images 1-100\] appeared."
        send "\003"
        set timeout 15
        expect {
            -re {[#$] } {}
            timeout {
                send "\r"
                set timeout 10
                expect -re {[#$] }
            }
        }
    }
}

# ══════════════════════════════════════════════════════════════════════════
# Test 3 of 3 — BERT-Tiny SST-2 transformer
# Let all 100 examples run. If the binary finishes within 15 minutes the
# full summary (including the CSV line) is captured in the log. If the
# 15-minute ceiling is hit, Ctrl+C is sent — the last [N/100] accuracy
# line already printed is the result.
#
# The C binary prints per-example accuracy after every record:
#   "  [N/100]  accuracy=%.2f%%  cycles=...  wall_ns=..."
# Final summary ends with a "CSV,BERT-Tiny-SST2,..." line.
# ══════════════════════════════════════════════════════════════════════════
puts "INFO: \[3/3\] bert-tiny-sst2 — running all 100 examples (15 min cap)..."
send "cd /Test/transformers && ./bert-tiny-sst2-stream-linux\r"

# 15-minute ceiling: 900 seconds
set timeout 900
expect {
    -re {CSV,BERT-Tiny-SST2[^\r\n]*} {
        set line $expect_out(0,string)
        puts "\nINFO: bert-tiny-sst2  COMPLETE RESULT: $line"
        # Binary has exited — just wait for the shell prompt
        set timeout 15
        expect {
            -re {[#$] } {}
            timeout {
                send "\r"
                set timeout 10
                expect -re {[#$] }
            }
        }
    }
    timeout {
        puts "WARNING: bert-tiny-sst2 — 15-minute cap reached; last accuracy line above is the result."
        send "\003"
        set timeout 15
        expect {
            -re {[#$] } {}
            timeout {
                send "\r"
                set timeout 10
                expect -re {[#$] }
            }
        }
    }
}

# ── Return to / and exit picocom ──────────────────────────────────────────
send "cd /\r"
set timeout 10
expect -re {[#$] }

puts "INFO: All tests done — $bitstream_name"
puts "INFO: Results captured in host log file."

send "\x01\x78"
exit 0
